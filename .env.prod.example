# On the server, copy this file to .env and fill it in. Never commit .env.

# The site's domain, without https://. Its DNS must point at this server.
# https://DOMAIN/api/auth/callback must be registered as a redirect URI in @stalzone_api_bot (/myapps).
DOMAIN=

# App credentials from @stalzone_api_bot (/myapps).
EXBO_CLIENT_ID=
EXBO_CLIENT_SECRET=

# Generate each of these with: openssl rand -hex 32
POSTGRES_PASSWORD=
SESSION_SECRET=
CRON_SECRET=
