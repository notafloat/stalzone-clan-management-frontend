# Copy this file to .env.local and fill in the values. Never commit .env.local.

# The address the site runs on, without a trailing slash.
# APP_URL + /api/auth/callback must be registered as a redirect URI in @stalzone_api_bot (/myapps).
APP_URL=http://localhost:3000

# App credentials from @stalzone_api_bot (/myapps).
EXBO_CLIENT_ID=
EXBO_CLIENT_SECRET=

# Encrypts session cookies, at least 32 characters. Changing it signs everyone out.
# The server refuses to start if this or anything above is missing.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Optional: clan history and fast page loads. The site works without these, but the
# journal and squads pages won't be available.
# This address matches docker-compose.yml. Use a different password when hosted.
DATABASE_URL=postgres://stalzone:stalzone_local@localhost:5433/stalzone_clan
# Protects the tracker endpoint.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Optional: database connections per server. Use a small number, like 1, on serverless hosting.
# DATABASE_POOL_SIZE=10

# Optional: see the site as another rank while developing. Only works with npm run dev.
# LEADER, COLONEL, OFFICER, SERGEANT, SOLDIER, COMMONER or RECRUIT.
# DEV_RANK=OFFICER

# Optional: these are the defaults.
# EXBO_OAUTH_URL=https://exbo.net/oauth
# STALZONE_API_URL=https://eapi.stalzone.com
